<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-source-set manifest additions. Merged into the debug variant only; every release build is built from
  `src/main/AndroidManifest.xml` alone and therefore contains none of this.

  `DebugAudioInjector` is a **debug-only PCM injection instrument** (P3.1 device diagnosis): it offers a WAV file's
  PCM straight to the live CXR `PcmIngress` so keyword-spotting recall can be measured without the acoustic path.
  It is `exported="true"` because the only caller is an `adb shell am broadcast` running as the shell UID - an
  unexported receiver cannot be reached that way and the instrument would be unusable. That export is exactly why
  this file must never be merged into a release build: no shipped APK may contain a component that accepts audio
  injection from a host shell.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugAudioInjector"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="edith.DEBUG_INJECT" />
            </intent-filter>
        </receiver>
        <!--
          P3.2 Stage 0 hint-length instrument. Same reasoning as `DebugAudioInjector`: the only caller is an
          `adb shell am broadcast` from the host, so it must be exported, and it must therefore never exist in a
          release build. It carries synthetic text only and logs counts only.
        -->
        <receiver
            android:name=".DebugHintInjector"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="edith.DEBUG_HINT" />
            </intent-filter>
        </receiver>
        <!--
          P3.3 Stage C instrument. Same reasoning and the same export rule as the two above: the only caller is an
          `adb shell am broadcast`, so it must be exported and must therefore never exist in a release build. It arms
          the scripted model wire, which answers the model request from a script instead of the network so the L3/L4
          half of the execution layer can be exercised through the real policy, gate, executor and audit. It bypasses
          nothing but the transport, and it logs the action name only - never the arguments.
        -->
        <receiver
            android:name=".DebugToolCallInjector"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="edith.DEBUG_TOOLCALL" />
            </intent-filter>
        </receiver>
        <!-- P5 Task 12: creates a model profile from .local/p5-omni.properties for AUDIO_REQUEST verification. -->
        <receiver
            android:name=".DebugProfileCreator"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="edith.DEBUG_CREATE_PROFILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
