<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The glasses side renders hints and nothing else: it captures no audio, reads no files and holds no credentials,
      so the phone owns the microphone, the model and the storage.
    -->
    <!--
      The one permission, approved as option A on 2026-10-08: a pushed hint must be able to light a sleeping panel.
      The vendor SDK has no wake API (the official FAQ documents only FLAG_KEEP_SCREEN_ON, and states that the ring's
      KEY_POWER screen on/off "应用层无法拦截"), so the standard Android screen wake lock is the only mechanism. It is
      held only while a hint is on screen and released on expiry, clear, disconnect or a bounded timeout.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      0.24 S2 Task 9 (D158): the production default is a foreground service that draws the official panel as a
      TYPE_APPLICATION_OVERLAY window, so it can appear over another app and while the glasses screen is off. The
      app-op must be granted by the wearer in settings; nothing here can grant it. specialUse is the only type that
      describes a resident display service with no media/location/phone category, and S1 measured that this Android 12
      build accepts it.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:label="EDITH"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".app.GlassesActivity"
            android:exported="true"
            android:label="EDITH">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The resident panel host; exported=false: only this app starts it. -->
        <service
            android:name=".app.GlassesOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
    </application>

</manifest>
