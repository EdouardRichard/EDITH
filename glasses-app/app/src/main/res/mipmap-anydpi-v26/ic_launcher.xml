<?xml version="1.0" encoding="utf-8"?>
<!-- App icon (owner decision 2026-10-22; background revised from transparent to white the same day: a transparent
     background let the launcher show through, and on the glasses' black UI it read as a black plate). The background
     layer is white and the foreground bitmap is a 108dp canvas whose artwork occupies the central 72dp visible area. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
